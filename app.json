{
  "expo": {
    "name": "piboss-language",
    "slug": "piboss-language",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "pibosslanguage",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d72a0e5f-7276-47fe-9c4f-da767a406157"
      }
    },
    "owner": "graziellygaleanos-team"
  }
}
